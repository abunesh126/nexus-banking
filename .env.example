# Example environment variables for local development
# After you deploy the Azure Function, set VITE_AZURE_FUNC_URL to the Function URL
# e.g.
# VITE_AZURE_FUNC_URL="https://<your-app>.azurewebsites.net/api/CurrencyConverter"

VITE_AZURE_FUNC_URL="https://your-function-url-here/api/CurrencyConverter"

# Other environment variables used by the app can go here as well
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_ANON_KEY=...
